// AHB-Lite single-manager adapter, available in 0.8.0.
// An unmapped transfer receives the required two-cycle ERROR response.
{
  signal: [
    { name: "HCLK",              wave: "p....." },
    ["Upstream",
      { name: "HTRANS",          wave: "====..", data: ["NONSEQ", "IDLE", "NONSEQ", "IDLE"] },
      { name: "HADDR",           wave: "=x=x..", data: ["hole", "mapped"] },
      { name: "HREADYOUT",       wave: "101..." },
      { name: "HRESP",           wave: "01.0.." }
    ],
    {},
    { name: "downstream HSEL",   wave: "0.10.." }
  ],
  head: { text: "AHB-Lite: local two-cycle ERROR (illustrative)" },
  foot: { text: "No child is selected for the hole; recovery waits for HREADY high." },
  config: { hscale: 2 }
}
